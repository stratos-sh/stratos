# Stratos Controller Environment Variables
# Copy this file to .env and adjust values as needed.
# All variables use the STRATOS_ prefix.
# CLI flags take precedence over environment variables.

# Cluster Configuration (required for AWS provider)
STRATOS_CLUSTER_NAME=my-cluster
STRATOS_CLUSTER_ENDPOINT=https://XXXXXXXXXXXXXXXX.gr7.us-west-2.eks.amazonaws.com
STRATOS_CLUSTER_CA=LS0tLS1CRUdJTi... # Base64-encoded CA certificate
STRATOS_CLUSTER_CIDR=172.20.0.0/16

# Cloud Provider
# Options: aws, fake
STRATOS_CLOUD_PROVIDER=aws

# Controller Settings
STRATOS_SYNC_PERIOD=30s
STRATOS_GRACEFUL_SHUTDOWN_TIMEOUT=30s
STRATOS_LEADER_ELECT=false

# Server Addresses
STRATOS_METRICS_BIND_ADDRESS=:8080
STRATOS_HEALTH_PROBE_BIND_ADDRESS=:8081
